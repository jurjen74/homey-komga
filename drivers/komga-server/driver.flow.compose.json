        {
          "name": "library",
          "type": "autocomplete",
          "title":       { "en": "Library" },
          "placeholder": { "en": "Select library…" }
        }
      ]
    },
    {
      "id": "scan_all_libraries",
      "title": { "en": "Scan all libraries" }
    }
