{
  "name": { "en": "Komga Recent", "nl": "Komga Recent", "de": "Komga Neuheiten" },
  "height": 1,
  "devices": {
    "type": "app",
    "singular": true,
    "filter": { "capabilities": "alarm_generic" }
  },
  "settings": [
    {
      "id": "layout",
      "type": "dropdown",
      "label": { "en": "Layout", "nl": "Indeling", "de": "Layout" },
      "value": "text",
      "values": [
        { "id": "text",           "label": { "en": "Text only",    "nl": "Alleen tekst",    "de": "Nur Text" } },
        { "id": "thumbnail-text", "label": { "en": "Cover & text", "nl": "Omslag & tekst",  "de": "Cover & Text" } },
        { "id": "thumbnail",      "label": { "en": "Covers only",  "nl": "Alleen omslagen", "de": "Nur Cover" } }
      ]
    },
    {
      "id": "groupBy",
      "type": "dropdown",
      "label": { "en": "Group by", "nl": "Groeperen op", "de": "Gruppieren nach" },
      "value": "none",
      "values": [
        { "id": "none",  "label": { "en": "No grouping", "nl": "Geen groepering",    "de": "Keine Gruppierung" } },
        { "id": "week",  "label": { "en": "Week",        "nl": "Week",               "de": "Woche" } },
        { "id": "month", "label": { "en": "Month",       "nl": "Maand",              "de": "Monat" } }
      ]
    },
    {
      "id": "showTitle",
      "type": "checkbox",
      "label": { "en": "Show title", "nl": "Titel tonen", "de": "Titel anzeigen" },
      "value": true
    },
    {
      "id": "count",
      "type": "number",
      "label": { "en": "Number of items", "nl": "Aantal items", "de": "Anzahl der Einträge" },
      "value": 5,
      "min": 1,
      "max": 20,
      "step": 1
    }
  ],
  "api": {
    "getRecent": {
      "method": "GET",
      "path": "/"
    }
  }
}
